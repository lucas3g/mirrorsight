{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mirrorsight",
  "version": "0.4.0",
  "identifier": "app.mirrorsight.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mirrorsight",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 420,
        "transparent": false,
        "decorations": false,
        "shadow": true,
        "center": true
      },
      {
        "label": "overlay",
        "title": "Mirrorsight Overlay",
        "url": "index.html",
        "width": 820,
        "height": 760,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://web.poecdn.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2OTFDMEY3RDFBRjg2NDAKUldSQWhxL1I5OENSVnAzTDlOcWVGVzEvNXR5RUtKRW82c0lWUldFM05kTVBrZW9VRjNvS20rUUQK",
      "endpoints": [
        "https://github.com/lucas3g/mirrorsight/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
